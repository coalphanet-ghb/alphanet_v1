# Gemini — create the key in Google AI Studio on a project with billing DISABLED.
# (Enabling billing kills the free tier on that project. See HANDOFF.md §3.)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — Project Settings > API. Use the service_role key (backend only,
# bypasses RLS). Never ship this key to a frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# NVIDIA build.nvidia.com trial (MiniMax-M3, --model M3)
NVIDIA_API_KEY=your_nvidia_api_key_here

# PAID API Key
FIREWORKS_API_KEY=fireworks_paid_key